# Copy to .env (gitignored) and fill in. Values must keep their double quotes:
# they are pasted verbatim into BuildConfig string fields.

# ── Uploads (release builds) ─────────────────────────────────────────────────
# The ingest endpoint (api/ingest.js, deployed on Vercel). When set, the APK carries
# NO database key: the endpoint validates every record and inserts with its own key.
INGEST_URL="https://<your-vercel-project>.vercel.app/api/ingest"
# Must equal INGEST_APP_TOKEN on the server. Not a secret (it ships in the APK); it only
# keeps casual traffic out.
INGEST_APP_TOKEN="<random-string>"

# ── Direct gateway (local testing only) ─────────────────────────────────────
# Used only when INGEST_URL is empty. Anything here ships inside the APK and can be
# extracted from it, so never put an admin key here.
GATEWAY_URL="https://<project>.<region>.gateway.sqlite.cloud/v2/weblite/sql"
API_KEY="<restricted-app-api-key>"
DB_NAME="Dataharvester_v2"

# ── Release signing (required for assembleRelease / publishUpdate) ──────────
# Every update must be signed with the SAME key as the app already on the phones, or
# Android refuses it ("App not installed as package appears to be invalid"). Share this
# keystore privately within the team; never commit it. To keep updating phones that got
# debug builds from one laptop, use that laptop's ~/.android/debug.keystore
# (alias androiddebugkey, passwords android).
SIGNING_STORE_FILE="C:/path/to/team-release.keystore"
SIGNING_STORE_PASSWORD="<store-password>"
SIGNING_KEY_ALIAS="<key-alias>"
SIGNING_KEY_PASSWORD="<key-password>"

# ── Update hosting (publishUpdate) ──────────────────────────────────────────
# APKs are attached to GitHub Releases of this repo (tag v<version>); apkUrl becomes
# https://github.com/<GITHUB_REPO>/releases/download/v<version>/DataHarvester-<version>.apk
GITHUB_REPO="saybbbb/Data-Harvester"
# Optional: any other folder that serves the APK file itself (not a web page such as a
# Google Drive share link). Leave empty to use GitHub Releases.
UPDATE_BASE_URL=""
