<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12+ (API 31+).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The install UUID (device_id_prefs), the collection state (data_harvester_prefs) and
   the Room database are never backed up or transferred. Restoring them on a reinstall
   or a new phone would reuse the same device_id with an older database (local ids
   reused, wrong counter baselines) and could make two phones upload as one.
   A reinstall or new phone therefore starts as a new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device_id_prefs.xml" />
        <exclude domain="sharedpref" path="data_harvester_prefs.xml" />
        <exclude domain="database" path="data_harvester_db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_id_prefs.xml" />
        <exclude domain="sharedpref" path="data_harvester_prefs.xml" />
        <exclude domain="database" path="data_harvester_db" />
    </device-transfer>
</data-extraction-rules>
