<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower (API <= 30).
   See https://developer.android.com/guide/topics/data/autobackup
   Note: This file is ignored for devices running API 31+ (see data_extraction_rules.xml)

   Same exclusions as data_extraction_rules.xml: the install UUID, the collection
   state and the Room database must not be restored onto a reinstall or a new phone.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="device_id_prefs.xml" />
    <exclude domain="sharedpref" path="data_harvester_prefs.xml" />
    <exclude domain="database" path="data_harvester_db" />
</full-backup-content>
