<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- ── Title ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 DATA HARVESTER"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <!-- ── Device ID Card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔗 Device Identity"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#757575"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/deviceIdText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: —"
                    android:textSize="13sp"
                    android:textColor="#424242"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/deviceModelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model: —"
                    android:textSize="13sp"
                    android:textColor="#424242" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Stats Card ── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: ○ Stopped"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#9E9E9E"
                    android:layout_marginBottom="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/recordCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Records: 0"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/appRecordCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="App Records: 0"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/todayUsageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today: 0.0 MB"
                    android:textSize="16sp"
                    android:textColor="#424242"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/lastRecordText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last: No records yet"
                    android:textSize="14sp"
                    android:textColor="#757575" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Usage Access Permission Card ── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/usageAccessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFF3E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Usage Access Required"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Per-app data tracking needs Usage Access permission. Tap below to grant it in Settings."
                    android:textSize="13sp"
                    android:textColor="#BF360C"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/grantUsageAccessButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔓  GRANT USAGE ACCESS"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#FF9800" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── Buttons ── -->

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶  START COLLECTION"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⏹  STOP COLLECTION"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F44336"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📤  EXPORT CSV"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/exportAppCsvButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📤  EXPORT APP USAGE CSV"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7B1FA2"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TrafficStats: 30s · NetworkStats (per-app): 10min"
            android:textSize="12sp"
            android:textColor="#BDBDBD"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
